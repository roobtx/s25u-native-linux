#!/data/data/com.termux/files/usr/bin/bash
# linuxvm — Debian 13 (trixie) in a REAL VM on Snapdragon, via Gunyah.
#
# Uses the hypervisor's *protected* VM path (the only one this device's TrustZone
# firmware provisions) while skipping pvmfw's AVB check:
#   --protected-vm-without-firmware
# Needs root. Android's own Linux Terminal app cannot do this: it asks for a
# NON-protected VM, which the firmware refuses outright.
#
# IMPORTANT — host memory fragmentation is what makes this VM crash.
# A protected VM needs large contiguous host pages. When /proc/buddyinfo shows
# no high-order blocks left (normal on a phone after hours of use), the VM dies
# right at the end of boot with:
#     unknown gh exit reason: 3      (GUNYAH_VCPU_EXIT_PAGE_FAULT)
#     vcpu hit unknown error: Invalid argument (os error 22)
# So this script drops caches and forces memory compaction before launching, and
# passes --hugepages. Without that the failure rate is ~100%; with it, it works.
#
#   linuxvm                  boot; you land in a root shell on the serial console
#   LINUXVM_MEM=2048         RAM in MiB
#   LINUXVM_CPUS=2           vCPUs
#   LINUXVM_NET=1            attach a tap NIC (needs `linuxvm-net` set up first)
#   LINUXVM_NOPREP=1         skip the drop_caches/compaction step
# Inside the VM:  poweroff   to shut down cleanly.
set -u
VMDIR=${LINUXVM_DIR:-/data/local/tmp/linuxvm}
MEM=${LINUXVM_MEM:-2048}
CPUS=${LINUXVM_CPUS:-2}
CROSVM=${LINUXVM_CROSVM:-/apex/com.android.virt/bin/crosvm}
NET=${LINUXVM_NET:-0}
NOPREP=${LINUXVM_NOPREP:-0}

command -v su >/dev/null 2>&1 || { echo "linuxvm: needs root (no su)" >&2; exit 1; }
su -c "test -r $VMDIR/vmlinuz && test -r $VMDIR/root_part" 2>/dev/null || {
  echo "linuxvm: need $VMDIR/vmlinuz and $VMDIR/root_part" >&2; exit 1; }

NETARG=""
[ "$NET" = 1 ] && NETARG="--net tap-name=crosvm0"

echo "linuxvm: booting Debian 13  (${MEM} MiB, ${CPUS} vCPU) — 'poweroff' to exit" >&2
exec su -c "
# stale crosvm holds a lock on the disk image
for p in \$(pgrep -x crosvm); do kill -9 \$p 2>/dev/null; done

if [ '$NOPREP' != 1 ]; then
  # defragment host memory — see the comment block above; this is not optional
  sync
  echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
  echo 1 > /proc/sys/vm/compact_memory 2>/dev/null
  sleep 2
fi

ulimit -l unlimited        # kernel caps locked memory at 64K otherwise; VM won't start

exec $CROSVM --log-level warn run \
  --disable-sandbox --no-balloon \
  --protected-vm-without-firmware --swiotlb 64 --hugepages $NETARG \
  --serial type=stdout,hardware=serial,num=1,console=true,stdin=true,earlycon=true \
  --params 'root=/dev/vda rw console=ttyS0 8250.nr_uarts=4 systemd.debug_shell=ttyS0 systemd.mask=serial-getty@ttyS0.service' \
  --mem $MEM --cpus $CPUS \
  --rwdisk $VMDIR/root_part \
  $VMDIR/vmlinuz
"
